# Install-scoped secrets and deployment identity. Everything else —
# LLM model + temperature, TTS voice/model, STT backend selection,
# turn-detection strategy + tuning, per-knob defaults — lives in the
# familiar's `character.toml` under the familiars root (see the on-disk
# layout docs). `data/familiars/_default/character.toml` is the tracked
# reference profile.

# Discord bot token.
DISCORD_BOT=

# OpenRouter (https://openrouter.ai/keys). Shared across every LLM call
# site; per-call-site model + temperature live in [llm.<slot>].
OPENROUTER_API_KEY=

# Cartesia TTS (https://play.cartesia.ai/keys). Required when
# [tts].provider="cartesia" (the default, and the only wired backend).
CARTESIA_API_KEY=

# Azure Speech (https://portal.azure.com — Cognitive Services → Speech).
# [tts].provider="azure" is NOT YET WIRED: the config value is accepted but
# refused at startup, so these are placeholders until the backend lands.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# Google Gemini (https://aistudio.google.com/apikey). `GEMINI_API_KEY` is
# accepted as a fallback. Like Azure, [tts].provider="gemini" is NOT YET
# WIRED and is refused at startup.
GOOGLE_API_KEY=

# Deepgram (https://console.deepgram.com/) — required when
# [providers.stt].backend="deepgram" (the default). All other Deepgram
# knobs (model, language, endpointing, keyterms, …) live in
# [providers.stt.deepgram].
DEEPGRAM_API_KEY=

# Which character under the familiars root to run. Override per
# invocation with `familiar-connect run --familiar <id>`.
FAMILIAR_ID=
